# Quest Board server settings. Copy to deploy/.env (never commit it) and fill in every REQUIRED value.
# After changing anything: docker compose up -d. The admin console's Setup tab checks these for you.
# This is the complete list of settings (a unit test keeps it that way: tests/unit/settings-documented).

# ── Your address (REQUIRED) ─────────────────────────────────────────────────────────────
# The domain whose DNS A record points at this server. Caddy gets the HTTPS certificate for it.
QUESTBOARD_DOMAIN=questboard.id
# Let's Encrypt contacts you here if a certificate can't be renewed.
QUESTBOARD_ACME_EMAIL=you@example.com
# The full https:// address: used in every link in emails, calendar feeds and shares.
QUESTBOARD_BASE_URL=https://questboard.id
# Tell browsers to use HTTPS only (HSTS) and upgrade insecure requests. Keep on behind Caddy.
QUESTBOARD_ENFORCE_HTTPS=true

# ── Email (REQUIRED: sign-up confirmations, password resets, reminders) ─────────────────
# Resend and/or Brevo with your domain verified (see deploy/EMAIL-DNS.md for the DNS records). With
# both, Resend is tried first and Brevo takes over when it's down or reaches its daily limit.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
# Strongly recommended: Brevo's free plan adds 300 emails a day (Resend's free plan: 100).
BREVO_API_KEY=
# The sender. Must be on the domain you verified with the provider(s).
QUESTBOARD_MAIL_FROM=Quest Board <halo@questboard.id>
# Each provider's daily limit (the free plans' by default; 0 = no limit, for a paid plan without one).
# Near a limit, notification emails and reminders wait so sign-ups and password resets still go out.
# RESEND_DAILY_LIMIT=100
# BREVO_DAILY_LIMIT=300
# Bounces and spam reports (deploy/EMAIL-DNS.md, "Bounces and spam reports"): addresses that bounce or
# report spam stop getting optional emails, so the providers don't suspend you. Resend: the webhook's
# signing secret. Brevo: any long random string, also put in the webhook URL (?token=…).
RESEND_WEBHOOK_SECRET=
QUESTBOARD_BREVO_WEBHOOK_TOKEN=

# ── Scheduled job (REQUIRED) ────────────────────────────────────────────────────────────
# A long random secret shared by the app and the scheduler container. Make one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
QUESTBOARD_CRON_SECRET=change-me-to-a-long-random-string
# How often the scheduler calls the job (minutes). 5 is right for reminders.
QUESTBOARD_CRON_MINUTES=5
# The nightly backup, in UTC (20 = 03:00 WIB). Backups go to the data volume's backups/ folder.
QUESTBOARD_BACKUP_HOUR_UTC=20
# How many nightly backups to keep on the server.
QUESTBOARD_BACKUP_KEEP=14

# ── Off-site copies of the backups (STRONGLY recommended) ───────────────────────────────
# A backup on the server's own disk doesn't survive losing the disk. Each nightly backup (gzipped) and
# every uploaded picture is also copied to S3-compatible storage — see deploy/README.md, "Off-site backups".
# Cloudflare R2: https://<account id>.r2.cloudflarestorage.com, region auto
# Backblaze B2:  https://s3.<region>.backblazeb2.com (e.g. s3.us-west-004), region = that region
QUESTBOARD_OFFSITE_ENDPOINT=
QUESTBOARD_OFFSITE_BUCKET=
QUESTBOARD_OFFSITE_REGION=auto
QUESTBOARD_OFFSITE_KEY_ID=
QUESTBOARD_OFFSITE_SECRET=
# Folder inside the bucket.
QUESTBOARD_OFFSITE_PREFIX=questboard/
# Days of database copies to keep off-site (the newest 3 always stay; pictures are never deleted).
# 60 days of a small site fits easily in the free 10 GB; 0 = keep everything.
QUESTBOARD_OFFSITE_KEEP_DAYS=60

# ── Small servers (deploy/README.md, "Small servers") ─────────────────────────────────────
# The ready-made image instead of building on the server (needs more memory than 1 GB):
# QUESTBOARD_IMAGE=ghcr.io/addin12/quest-board:latest
# Memory caps for the app and the scheduler (they use about 225 MB and 10 MB on a busy evening).
# QUESTBOARD_APP_MEMORY=768m
# QUESTBOARD_SCHEDULER_MEMORY=384m
# How long update.sh waits for a new version to be healthy before going back (seconds).
# QUESTBOARD_UPDATE_WAIT=180

# ── Legal and contact (REQUIRED before opening to the public) ───────────────────────────
# Shown on the Terms and Privacy pages; UU PDP expects an address for data requests.
QUESTBOARD_CONTACT_EMAIL=halo@questboard.id
# Set to true once the Terms and Privacy texts are final (hides the "draft" notice).
QUESTBOARD_LEGAL_FINAL=false

# ── Set by the image; change only if you know why ───────────────────────────────────────
# QUESTBOARD_SEED=false                      never create demo accounts (they have a known password)
# QUESTBOARD_DB=/data/questboard.db
# QUESTBOARD_UPLOAD_DIR=/data/uploads
# QUESTBOARD_BACKUP_DIR=/data/backups
# QUESTBOARD_PROXY_HOPS=1                    reverse proxies in front of the app (Caddy = 1)
# QUESTBOARD_APP_URL=http://app:3000         where the scheduler finds the app
# QUESTBOARD_ENV_FILE=.env                   which settings file docker compose reads (set in the shell, not here;
#                                            the rehearsals use rehearsal/rehearsal.env)

# ── NEVER set these on a real server (development and automated tests only) ─────────────
# QUESTBOARD_DEV_OUTBOX, QUESTBOARD_ALLOW_RESET, QUESTBOARD_INSECURE_COOKIES,
# QUESTBOARD_ADMIN_TWO_STEP, QUESTBOARD_RATE_LIMIT, QUESTBOARD_RATE_LIMIT_OVERRIDES,
# QUESTBOARD_RESEND_URL, QUESTBOARD_BREVO_URL (point email at the rehearsal's stand-ins)
