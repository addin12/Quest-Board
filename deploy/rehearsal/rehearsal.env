# Settings for the local production rehearsal only (not secrets: nothing here is used for real).
# Like a real server, except: localhost with Caddy's own certificate, the job every minute, and email and
# off-site backups going to the rehearsal's stand-ins (the "fakes" service) instead of Resend, Brevo and R2/B2.
QUESTBOARD_DOMAIN=localhost
QUESTBOARD_ACME_EMAIL=rehearsal@example.com
QUESTBOARD_BASE_URL=https://localhost:8443
QUESTBOARD_ENFORCE_HTTPS=true
QUESTBOARD_CRON_SECRET=rehearsal-cron-secret-not-for-real-use
QUESTBOARD_CRON_MINUTES=1
QUESTBOARD_CONTACT_EMAIL=rehearsal@example.com
QUESTBOARD_LEGAL_FINAL=false
RESEND_API_KEY=rehearsal-resend-key
QUESTBOARD_MAIL_FROM=Quest Board <rehearsal@example.com>
QUESTBOARD_RESEND_URL=http://fakes:4000
BREVO_API_KEY=rehearsal-brevo-key
QUESTBOARD_BREVO_URL=http://fakes:4000
QUESTBOARD_OFFSITE_ENDPOINT=http://fakes:4000
QUESTBOARD_OFFSITE_BUCKET=rehearsal-bucket
QUESTBOARD_OFFSITE_REGION=auto
QUESTBOARD_OFFSITE_KEY_ID=rehearsal-key-id
QUESTBOARD_OFFSITE_SECRET=rehearsal-secret-not-for-real-use
