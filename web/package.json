{
  "name": "quest-board",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node --conditions=react-server --import ./tests/loader.mjs --test \"tests/unit/*.test.ts\"",
    "test:e2e": "npm run build && playwright test",
    "db:reset": "node scripts/reset-db.mjs",
    "icons": "node scripts/build-icons.mjs",
    "placeholders": "node scripts/build-placeholders.mjs",
    "tavern-art": "node scripts/build-tavern-art.mjs",
    "admin": "node scripts/admin.mjs",
    "app-icons": "node scripts/build-app-icons.mjs",
    "db:backup": "node scripts/db-backup.mjs backup",
    "load-test": "node scripts/load-test.mjs",
    "db:restore": "node scripts/db-backup.mjs restore"
  },
  "dependencies": {
    "@flaticon/flaticon-uicons": "^3.3.1",
    "next": "16.3.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.13.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "subset-font": "^2.9.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "license": "MIT"
}
